<?xml version="1.0" encoding="utf-8"?>
<!-- M06 · Perfil — "profile-edit · Editar datos" (Figma, nodo 6:1840) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bananos_fondo"
    android:orientation="vertical"
    tools:context=".EditarDatosFragment">

    <!-- Cabecera: chevron + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/registro_volver"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/bananos_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editar_titulo"
            android:textColor="@color/bananos_texto"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Bananos.Campo.Etiqueta"
                android:labelFor="@id/etNombre"
                android:text="@string/registro_nombre" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Bananos.Campo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    style="@style/Bananos.Campo.Texto"
                    android:autofillHints="name"
                    android:hint="@string/registro_nombre_ejemplo"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="150"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Bananos.Campo.Etiqueta"
                android:labelFor="@id/etCelular"
                android:text="@string/registro_celular" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCelular"
                style="@style/Bananos.Campo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCelular"
                    style="@style/Bananos.Campo.Texto"
                    android:autofillHints="phoneNational"
                    android:digits="0123456789"
                    android:hint="@string/registro_celular_ejemplo"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="9"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Bananos.Campo.Etiqueta"
                android:labelFor="@id/etDireccion"
                android:text="@string/registro_direccion" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDireccion"
                style="@style/Bananos.Campo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDireccion"
                    style="@style/Bananos.Campo.Texto"
                    android:autofillHints="postalAddress"
                    android:hint="@string/registro_direccion_ejemplo"
                    android:imeOptions="actionDone"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="250"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Correo: solo lectura (el backend no permite cambiarlo) -->
            <TextView
                style="@style/Bananos.Campo.Etiqueta"
                android:labelFor="@id/etCorreo"
                android:text="@string/editar_correo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Bananos.Campo"
                app:boxBackgroundColor="@color/bananos_verde_claro">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    style="@style/Bananos.Campo.Texto"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:hint="@string/registro_correo_ejemplo"
                    android:inputType="none"
                    android:maxLines="1"
                    android:textColor="@color/bananos_texto_secundario" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Bananos.BotonPrincipal"
                android:layout_marginTop="16dp"
                android:text="@string/editar_boton" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
