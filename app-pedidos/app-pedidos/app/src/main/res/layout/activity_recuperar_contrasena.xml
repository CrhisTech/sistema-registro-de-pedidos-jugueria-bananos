<?xml version="1.0" encoding="utf-8"?>
<!-- Autenticación — Recuperar contraseña -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bananos_fondo"
    android:orientation="vertical"
    tools:context=".RecuperarContrasenaActivity">

    <!-- Cabecera: chevron + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recuperar_volver"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/bananos_texto" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recuperar_titulo"
            android:textColor="@color/bananos_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Etiqueta del correo -->
            <TextView
                style="@style/Bananos.Campo.Etiqueta"
                android:labelFor="@id/etCorreo"
                android:text="@string/registro_correo" />

            <!-- Campo correo electrónico -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Bananos.Campo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    style="@style/Bananos.Campo.Texto"
                    android:autofillHints="emailAddress"
                    android:hint="@string/registro_correo_ejemplo"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLength="150"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Acción principal + progreso superpuesto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecuperar"
                    style="@style/Bananos.BotonPrincipal"
                    android:text="@string/recuperar_boton" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/white"
                    app:indicatorSize="24dp"
                    app:trackThickness="3dp" />

            </FrameLayout>

            <!-- Fila de menú: Volver al inicio de sesión -->
            <LinearLayout
                android:id="@+id/filaIrLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recuperar_ir_login"
                    android:textColor="@color/bananos_texto"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/bananos_texto" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
