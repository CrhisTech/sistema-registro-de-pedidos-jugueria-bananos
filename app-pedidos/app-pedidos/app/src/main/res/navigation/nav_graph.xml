<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/cartaFragment">

    <fragment
        android:id="@+id/carritoFragment"
        android:name="pe.idat.app_pedidos.CarritoFragment"
        android:label="fragment_carrito"
        tools:layout="@layout/fragment_carrito" />
    <fragment
        android:id="@+id/cartaFragment"
        android:name="pe.idat.app_pedidos.CartaFragment"
        android:label="fragment_carta"
        tools:layout="@layout/fragment_carta" />
    <fragment
        android:id="@+id/perfilFragment"
        android:name="pe.idat.app_pedidos.PerfilFragment"
        android:label="fragment_perfil"
        tools:layout="@layout/fragment_perfil">
        <action
            android:id="@+id/action_perfilFragment_to_editarDatosFragment"
            app:destination="@id/editarDatosFragment" />
        <action
            android:id="@+id/action_perfilFragment_to_cambiarContrasenaFragment"
            app:destination="@id/cambiarContrasenaFragment" />
    </fragment>
    <fragment
        android:id="@+id/editarDatosFragment"
        android:name="pe.idat.app_pedidos.EditarDatosFragment"
        android:label="fragment_editar_datos"
        tools:layout="@layout/fragment_editar_datos" />
    <fragment
        android:id="@+id/cambiarContrasenaFragment"
        android:name="pe.idat.app_pedidos.CambiarContrasenaFragment"
        android:label="fragment_cambiar_contrasena"
        tools:layout="@layout/fragment_cambiar_contrasena" />
    <fragment
        android:id="@+id/pedidosFragment"
        android:name="pe.idat.app_pedidos.PedidosFragment"
        android:label="fragment_pedidos"
        tools:layout="@layout/fragment_pedidos" />
</navigation>