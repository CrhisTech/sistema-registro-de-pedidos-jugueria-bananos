<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de Bananos.Opcion: verde claro con borde verde cuando está elegida -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bananos_opcion_elegida" />
            <stroke android:width="1dp" android:color="@color/bananos_verde" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bananos_superficie" />
            <stroke android:width="1dp" android:color="@color/bananos_borde" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
