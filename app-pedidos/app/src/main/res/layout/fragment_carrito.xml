<?xml version="1.0" encoding="utf-8"?>
<!-- M02 · Carrito — "cart · Tu carrito" y "cart-empty · Tu carrito" (Figma, nodos 5:735 y 5:791) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bananos_fondo"
    android:orientation="vertical"
    tools:context=".CarritoFragment">

    <!-- Cabecera: chevron + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/registro_volver"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/bananos_verde" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/carrito_titulo"
            android:textColor="@color/bananos_texto"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Carrito con productos -->
    <LinearLayout
        android:id="@+id/layoutProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/carrito_descripcion"
                    android:textColor="@color/bananos_texto_secundario"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCarrito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_carrito" />

                <!-- Fila de menú: "Agregar más productos" -> Carta -->
                <LinearLayout
                    android:id="@+id/filaAgregarMas"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/carrito_agregar_mas"
                        android:textColor="@color/bananos_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/bananos_texto" />
                </LinearLayout>

                <!-- Resumen: Total -->
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_resumen"
                    android:padding="16dp"
                    android:textColor="@color/bananos_texto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Total · S/ 7,00" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Acción fija -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuar"
            style="@style/Bananos.BotonPrincipal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            android:text="@string/carrito_continuar" />
    </LinearLayout>

    <!-- Carrito vacío -->
    <LinearLayout
        android:id="@+id/layoutVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_backpack"
            app:tint="@color/bananos_verde" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/carrito_vacio_titulo"
            android:textColor="@color/bananos_texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/carrito_vacio_descripcion"
            android:textColor="@color/bananos_texto_secundario"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplorarCarta"
            style="@style/Bananos.BotonPrincipal"
            android:layout_marginTop="12dp"
            android:text="@string/carrito_explorar" />
    </LinearLayout>
</LinearLayout>
